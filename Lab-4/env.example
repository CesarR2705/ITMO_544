# Copy to .env and fill in your values (same as Lab-3, plus the Lab-4 block)
AWS_REGION=us-east-2
BUCKET_NAME=your-bucket-name
AMI_ID=ami-xxxxxxxxxxxxxxxxx
INSTANCE_TYPE=t3.micro
KEY_NAME=your-key-pair
APP_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
UPLOADER_ROLE_NAME=itmo-444-544-uploader-role
VIEWER_ROLE_NAME=itmo-444-544-viewer-role
UPLOADER_PROFILE_NAME=itmo-444-544-uploader-profile
VIEWER_PROFILE_NAME=itmo-444-544-viewer-profile
UPLOADER_LT_NAME=itmo-444-544-uploader-lt
VIEWER_LT_NAME=itmo-444-544-viewer-lt
# Lab-4 additions
UPLOADER_TG_NAME=itmo-444-544-uploader-tg
VIEWER_TG_NAME=itmo-444-544-viewer-tg
UPLOADER_ASG_NAME=itmo-444-544-uploader-asg
VIEWER_ASG_NAME=itmo-444-544-viewer-asg
ALB_NAME=itmo-444-544-app-alb
ALB_SG_NAME=itmo-444-544-alb-sg
UPLOADER_LISTENER_PORT=8080
VIEWER_LISTENER_PORT=8081
AZ_A=us-east-2a
AZ_B=us-east-2b
RECOVERY_SLO_SECONDS=180
